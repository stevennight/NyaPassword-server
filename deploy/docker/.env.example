# --- Image ---
# Release to run (a tag from GitHub Releases, without the leading v)
VERSION=0.1.0
# IMAGE=ghcr.io/example/nyapassword-server

# --- Server ---
# Listen address; keep it on loopback behind Caddy
LISTEN=127.0.0.1:8087
LOG=info
TZ=Asia/Shanghai

# --- Admin console ---
# Used once, when no admin password is set yet; afterwards change it with
#   docker compose exec nyapassword nyapassword-server admin-password
ADMIN_PASSWORD=
